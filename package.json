{
  "name": "personal_branding",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "server": "node server.js",
    "dev:full": "concurrently \"npm run server\" \"npm run dev\"",
    "build": "npm run fetch-discogs && npm run enrich-spotify && npm run enrich-getsongbpm && npm run report && vite build",
    "build:full": "npm run fetch-discogs -- --full && npm run enrich-spotify -- --full && npm run enrich-getsongbpm -- --full && npm run report && vite build",
    "build:skip-getsongbpm": "npm run fetch-discogs && npm run enrich-spotify && npm run enrich-getsongbpm -- --skip && npm run report && vite build",
    "build:full-skip-getsongbpm": "npm run fetch-discogs -- --full && npm run enrich-spotify -- --full && npm run enrich-getsongbpm -- --skip && npm run report && vite build",
    "build:fast": "vite build",
    "build:with-enrich": "npm run enrich-spotify && vite build",
    "lint": "eslint .",
    "preview": "vite preview",
    "fetch-discogs": "node scripts/fetchDiscogs.js",
    "postinstall": "node scripts/fetchDiscogs.js",
    "enrich-spotify": "node scripts/enrichSpotify.js",
    "enrich-getsongbpm": "node scripts/enrichGetSongBPM.js",
    "enrich-getsongbpm:test": "node scripts/enrichGetSongBPM.js 2 5",
    "report": "node scripts/generateReport.js"
  },
  "dependencies": {
    "@upstash/redis": "^1.34.0",
    "axios": "^1.13.2",
    "cors": "^2.8.5",
    "dompurify": "^3.3.1",
    "dotenv": "^17.2.3",
    "express": "^5.2.1",
    "express-rate-limit": "^8.2.1",
    "framer-motion": "^12.23.25",
    "html2canvas": "^1.4.1",
    "isomorphic-dompurify": "^2.35.0",
    "jspdf": "^4.0.0",
    "jspdf-autotable": "^5.0.7",
    "leaflet": "^1.9.4",
    "nodemailer": "^7.0.11",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "react-leaflet": "^4.2.1",
    "react-router-dom": "^6.20.0",
    "recharts": "^2.10.3",
    "redis": "^4.7.0",
    "validator": "^13.15.26"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.1",
    "@types/react": "^18.3.1",
    "@types/react-dom": "^18.3.0",
    "@vitejs/plugin-react": "^4.3.3",
    "concurrently": "^9.2.1",
    "eslint": "^9.39.1",
    "eslint-plugin-react-hooks": "^7.0.1",
    "eslint-plugin-react-refresh": "^0.4.24",
    "globals": "^16.5.0",
    "vite": "^5.4.11"
  }
}
